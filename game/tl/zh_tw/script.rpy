    z "所以你啥時有空？"

# game/script.rpy:456
translate zh_tw day4_6089f08b:

    # p "Tomorrow? I don't have class in the afternoon."
    p "明天？我明天下午沒課。"

# game/script.rpy:457
translate zh_tw day4_6f9c175f:

    # z "Got it!"
    z "收到！"

# game/script.rpy:458
translate zh_tw day4_a20cefa7:

    # "..."
    "..."

# game/script.rpy:459
translate zh_tw day4_3fafc5be:

